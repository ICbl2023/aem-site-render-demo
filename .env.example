# Ne jamais publier .env ni communiquer les identifiants dans le navigateur.
AEM_FROM=
# Notification des nouveaux dossiers (zone admin) — adresse demandée par AEM
AEM_RECIPIENT=aemseve@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Exemple d'origine : https://www.exemple.test (sans chemin)
AEM_ORIGIN=
# Lien public de la zone admin, mis dans chaque mail de notification (à renseigner à la mise en ligne)
# Exemple : https://www.exemple.test/admin.html
AEM_ADMIN_URL=
# Exemple de sous-dossier : /questionnaires
AEM_BASE_PATH=
HOST=127.0.0.1
PORT=3000
AEM_RECEIPT_DIR=.runtime
AEM_DATA_DIR=.data
# Brouillons en cours, séparés des dossiers envoyés : ils permettent au candidat de reprendre
# son questionnaire depuis un autre téléphone, une tablette ou un ordinateur, via son lien de reprise.
# Effacés 7 jours après la dernière modification, et dès l'envoi du dossier.
AEM_DRAFT_DIR=.data-brouillons
# 0 = brouillon conservé dans le navigateur seulement (pas de reprise d'un appareil à l'autre)
AEM_DRAFTS=1
# Compte unique "admin" (compatibilité) si AEM_ADMIN_ACCOUNTS est vide
AEM_ADMIN_PASSWORD=
# Comptes nommés : "identifiant:motdepasse;identifiant2:motdepasse2" (prioritaire sur AEM_ADMIN_PASSWORD)
# Les mots de passe ne peuvent contenir ni « ; » ni « : ». Les entrées invalides sont ignorées (nombre journalisé au démarrage, sans les valeurs).
# Comptes nommés "identifiant:motdepasse:rôle" séparés par ";" ; rôles : lecture (consulter), traitement (par défaut : agir), responsable (en plus : réglages du service)
# Exemple : accueil:motdepasse:lecture;marie:motdepasse;luc:motdepasse:responsable
AEM_ADMIN_ACCOUNTS=
AEM_ADMIN_SALT=aem-admin
# 0 = ne pas envoyer d’accusé de réception au candidat (1 par défaut, si SMTP configuré)
AEM_CANDIDATE_MAIL=1
# Clé API Anthropic (assistant IA), laisser vide pour désactiver
ANTHROPIC_API_KEY=
# 1 = joindre les pièces au mail (déconseillé si l’admin est utilisé)
AEM_MAIL_ATTACHMENTS=0
# Suppression automatique des dossiers classés après N jours (0 = désactivé)
AEM_RETENTION_DAYS=365
# 1 derrière Render / reverse proxy pour l’IP réelle (rate limit)
TRUST_PROXY=0
# Phase de test uniquement : préremplit l’écran de connexion admin (à laisser vide en production)
AEM_ADMIN_PREFILL=
